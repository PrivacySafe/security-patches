# =============================================================================
# php2shell-watch systemd unit - run the live log watcher as a service
# CVE-2026-109618 / CVE-2026-109619
#
# If this script was helpful, consider a donation to our 501c3 nonprofit:
# https://privacysafe.foundation
#
# Install the script at /usr/local/sbin, then:
#   cp php2shell-watch.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now php2shell-watch
#   journalctl -fu php2shell-watch     # watch it
# =============================================================================
[Unit]
Description=php2shell log watcher (read-only)
After=php-fpm.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/php2shell-watch.sh
Restart=on-failure
# read-only; drop privileges but keep log read access via the adm group
User=root
Nice=10

[Install]
WantedBy=multi-user.target
