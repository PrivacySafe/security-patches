# =============================================================================
# php2shell-watch systemd unit, packaged for /opt/psf-security-patches
# CVE-2026-109618 / CVE-2026-109619
#
# If this software is helpful, consider a donation to our 501c3 nonprofit:
# https://privacysafe.foundation
#
# The psf-security-packages deb and rpm install this file but do not enable it:
#   systemctl daemon-reload && systemctl enable --now php2shell-watch
#   journalctl -fu php2shell-watch     # watch it
# =============================================================================
[Unit]
Description=php2shell log watcher (read-only)
Documentation=file:/opt/psf-security-patches/php/README.md https://codeberg.org/PrivacySafe/security-patches
After=php-fpm.service

[Service]
Type=simple
ExecStart=/opt/psf-security-patches/php/php2shell-watch.sh
Restart=on-failure
# read-only; drop privileges but keep log read access via the adm group
User=root
Nice=10

[Install]
WantedBy=multi-user.target
