%global debug_package %{nil}
%global _build_id_links none
%global __os_install_post %{nil}

Name:           psf-security-patches
Version:        @DATEVER@
Release:        @REV@
Summary:        PrivacySafe security checks, hunts and protection for serious vulnerabilities
License:        CC0-1.0
URL:            https://privacysafe.app/docs/security-patches/
Source0:        %{name}-%{version}-%{release}.tar.gz
BuildArch:      noarch
AutoReqProv:    no
Requires:       bash >= 4.0
Requires:       coreutils
Obsoletes:      psf-security-packages < 26.10.30
Packager:       @MAINT@
Vendor:         PrivacySafe Foundation

%description
Free public domain tools for GNU/Linux servers. For each serious
vulnerability they tell you whether you are exposed, look for signs that
someone has already used the flaw, and, where there is a safe way to do it,
protect the machine until you can update. Covers the October 2026
vulnerabilities in vsftpd, the Claude Code extension, Brotli, HAProxy,
rsyslog, YOOtheme, Django REST framework, libexpat, baserCMS, Ruby and
GitLab, PHP2Shell, WordPress, nginx, Tomcat, the Linux kernel and more.

Start with: man psf-security-patches. Every tool has its own manual page
(psf-NAME) and the whole set is in the info manual: info psf-security-patches.

The tools install under /opt/psf-security-patches, plus the php2shell-watch
systemd unit, which is not enabled automatically. Updating is the permanent
fix; the tools protect you until then and show whether you were hit.

Built and published by PrivacySafe Foundation, a 501(c)(3) nonprofit, with
the assistance of Ivy Cyber LLC. CC0 1.0 Universal.

%prep
%setup -q -n %{name}-%{version}-%{release}

%build

%install
rm -rf %{buildroot}
install -d %{buildroot}/opt/psf-security-patches
cp -a . %{buildroot}/opt/psf-security-patches/
rm -rf %{buildroot}/opt/psf-security-patches/packaging \
       %{buildroot}/opt/psf-security-patches/.gitattributes
find %{buildroot}/opt/psf-security-patches -type d -exec chmod 0755 {} +
find %{buildroot}/opt/psf-security-patches -type f -exec chmod 0644 {} +
find %{buildroot}/opt/psf-security-patches -type f -name '*.sh' -exec chmod 0755 {} +
install -D -m 0644 packaging/systemd/php2shell-watch.service \
    %{buildroot}/usr/lib/systemd/system/php2shell-watch.service
rm -rf %{buildroot}/opt/psf-security-patches/man %{buildroot}/opt/psf-security-patches/site
if [ -d site ]; then
  install -d %{buildroot}%{_docdir}/%{name}-%{version}/html
  cp -a site/. %{buildroot}%{_docdir}/%{name}-%{version}/html/
  find %{buildroot}%{_docdir}/%{name}-%{version}/html -type d -exec chmod 0755 {} +
  find %{buildroot}%{_docdir}/%{name}-%{version}/html -type f -exec chmod 0644 {} +
fi
install -d %{buildroot}%{_mandir}/man8 %{buildroot}%{_mandir}/man7 %{buildroot}%{_infodir}
for f in man/man8/*.8; do gzip -9n < "$f" > %{buildroot}%{_mandir}/man8/$(basename "$f").gz; done
gzip -9n < man/man7/psf-security-patches.7 > %{buildroot}%{_mandir}/man7/psf-security-patches.7.gz
gzip -9n < man/psf-security-patches.info > %{buildroot}%{_infodir}/psf-security-patches.info.gz
find %{buildroot}%{_mandir} %{buildroot}%{_infodir} -type f -exec chmod 0644 {} +

%files
%defattr(-,root,root,-)
%license LICENSE NOTICE
%doc README.md CHANGELOG.md
/opt/psf-security-patches
/usr/lib/systemd/system/php2shell-watch.service
%{_mandir}/man7/psf-security-patches.7*
%{_mandir}/man8/psf-*.8*
%{_infodir}/psf-security-patches.info*
%{_docdir}/%{name}-%{version}/html

%changelog
* @RPMDATE@ @MAINT@ - @DATEVER@-@REV@
- Release of PrivacySafe Security Patches. See CHANGELOG.md for details.
