%global debug_package %{nil}
%global _build_id_links none
%global __os_install_post %{nil}

Name:           psf-security-patches
Version:        @DATEVER@
Release:        @REV@
Summary:        PrivacySafe security checks, hunts and protection for serious vulnerabilities
License:        CC0-1.0
URL:            https://privacysafe.app/docs/security-patches/
Source0:        %{name}-%{version}-%{release}.tar.gz
Source1:        %{name}-%{version}-%{release}-docs.tar.gz
BuildArch:      noarch
AutoReqProv:    no
Requires:       bash >= 4.0
Requires:       coreutils
Recommends:     python3
Obsoletes:      psf-security-packages < 26.10.30
Provides:       psf-security-packages = %{version}-%{release}
Packager:       @MAINT@
Vendor:         PrivacySafe Foundation

%description
Free public domain tools for GNU/Linux servers. For each serious
vulnerability they tell you whether you are exposed, look for signs that
someone has already used the flaw, and, where there is a safe way to do it,
protect the machine until you can update. Covers the October and
November 2026 vulnerabilities in vsftpd, BTCPay Server, the Claude Code
extension, Brotli, HAProxy,
rsyslog, YOOtheme, Django REST framework, Expat, baserCMS, Ruby and
GitLab, PHP2Shell, WordPress, nginx, Tomcat, the Linux kernel and more.

Start with: man psf-security-patches. Every tool has its own manual page
(psf-NAME) and the whole set is in the info manual: info psf-security-patches.

On Red Hat family hosts, psf-rhsa (man psf-rhsa) finds Red Hat's security
advisories for a CVE and checks the installed packages against Red Hat's
fixes. It needs python3, which is recommended, not required.

The tools install under /opt/psf-security-patches, plus the php2shell-watch
systemd unit, which is not enabled automatically. Updating is the permanent
fix; the tools protect you until then and show whether you were hit.

Built and published by PrivacySafe Foundation, a 501(c)(3) nonprofit, with
the assistance of Ivy Cyber LLC. CC0 1.0 Universal.

%prep
%setup -q -n %{name}-%{version}-%{release}
# The manual pages are generated when the release is built. The documentation site is in docs/ of the source tree and is installed under the doc directory below, not under /opt.
tar -xzf %{SOURCE1}

%build

%install
rm -rf %{buildroot}
install -d %{buildroot}/opt/psf-security-patches
cp -a . %{buildroot}/opt/psf-security-patches/
# the Red Hat advisory checker is the one part of packaging/ that is installed
install -d %{buildroot}/opt/psf-security-patches/rhsa
cp -a packaging/rhsa/. %{buildroot}/opt/psf-security-patches/rhsa/
rm -rf %{buildroot}/opt/psf-security-patches/packaging \
       %{buildroot}/opt/psf-security-patches/docs \
       %{buildroot}/opt/psf-security-patches/.gitattributes \
       %{buildroot}/opt/psf-security-patches/.gitignore
find %{buildroot}/opt/psf-security-patches -type d -exec chmod 0755 {} +
find %{buildroot}/opt/psf-security-patches -type f -exec chmod 0644 {} +
find %{buildroot}/opt/psf-security-patches -type f -name '*.sh' -exec chmod 0755 {} +
chmod 0755 %{buildroot}/opt/psf-security-patches/rhsa/rhsa.py
install -D -m 0644 php/php2shell-watch.service \
    %{buildroot}/usr/lib/systemd/system/php2shell-watch.service
rm -rf %{buildroot}/opt/psf-security-patches/man %{buildroot}/opt/psf-security-patches/site
if [ -d site ]; then
  install -d %{buildroot}%{_docdir}/%{name}-%{version}/html
  cp -a site/. %{buildroot}%{_docdir}/%{name}-%{version}/html/
  rm -f %{buildroot}%{_docdir}/%{name}-%{version}/html/.nojekyll
  find %{buildroot}%{_docdir}/%{name}-%{version}/html -type d -exec chmod 0755 {} +
  find %{buildroot}%{_docdir}/%{name}-%{version}/html -type f -exec chmod 0644 {} +
fi
install -d %{buildroot}%{_mandir}/man8 %{buildroot}%{_mandir}/man7 %{buildroot}%{_infodir}
for f in man/man8/*.8; do gzip -9n < "$f" > %{buildroot}%{_mandir}/man8/$(basename "$f").gz; done
gzip -9n < man/man7/psf-security-patches.7 > %{buildroot}%{_mandir}/man7/psf-security-patches.7.gz
gzip -9n < man/psf-security-patches.info > %{buildroot}%{_infodir}/psf-security-patches.info.gz
find %{buildroot}%{_mandir} %{buildroot}%{_infodir} -type f -exec chmod 0644 {} +
# %license and %doc, used below, each make rpm create their directory and copy these files
# into it itself, as a packaging step that runs after %install and is not covered by
# clamp_mtime_to_source_date_epoch for the directory entry, leaving its mtime as the real
# build time and making the package non-reproducible even though every file's content is
# identical build to build. Create and populate these directories ourselves instead, so they
# are covered by the same clamp below as everything else, and list them as plain paths in
# %files rather than with %license/%doc.
install -d %{buildroot}%{_licensedir}/%{name}-%{version} %{buildroot}%{_docdir}/%{name}-%{version}
install -m 0644 LICENSE NOTICE %{buildroot}%{_licensedir}/%{name}-%{version}/
install -m 0644 README.md CHANGELOG.md %{buildroot}%{_docdir}/%{name}-%{version}/
# clamp_mtime_to_source_date_epoch only lowers an mtime that is later than SOURCE_DATE_EPOCH on
# files rpm itself copies into the payload; directories created directly by install -d above
# keep the real build-time mtime, which makes the package non-reproducible even though every
# file's content is identical build to build. Clamp everything under the buildroot explicitly,
# now that %install is otherwise finished; build-release.sh exports SOURCE_DATE_EPOCH.
find %{buildroot} -exec touch -h -d "@${SOURCE_DATE_EPOCH}" {} +

%files
%defattr(-,root,root,-)
%license %{_licensedir}/%{name}-%{version}/LICENSE
%license %{_licensedir}/%{name}-%{version}/NOTICE
%doc %{_docdir}/%{name}-%{version}/README.md
%doc %{_docdir}/%{name}-%{version}/CHANGELOG.md
/opt/psf-security-patches
/usr/lib/systemd/system/php2shell-watch.service
%{_mandir}/man7/psf-security-patches.7*
%{_mandir}/man8/psf-*.8*
%{_infodir}/psf-security-patches.info*
%{_docdir}/%{name}-%{version}/html

%changelog
* @RPMDATE@ @MAINT@ - @DATEVER@-@REV@
- Release of PrivacySafe Security Patches. See CHANGELOG.md for details.

# Assisted-by: Claude Sonnet 5.5
